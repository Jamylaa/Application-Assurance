# JWT Configuration
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/vermeg_db
MONGODB_DATABASE=vermeg_db
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change_me

# Keycloak Admin (bootstrap dev uniquement)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change_me

# Email Configuration (Gmail)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password

# Service Ports
USER_SERVICE_PORT=9094
PRODUCT_SERVICE_PORT=9093
CHATBOT_SERVICE_PORT=9001
FRONTEND_PORT=4200
KEYCLOAK_PORT=9090
MONGODB_PORT=27017

# Frontend URL
FRONTEND_URL=http://localhost:4200

# Google API (si utilise par un service Java)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Configuration
CORS_ORIGINS=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Eureka Configuration
EUREKA_SERVER_URL=http://localhost:8761/eureka
