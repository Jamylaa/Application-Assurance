# FastAPI Configuration
FASTAPI_ENV=development
FASTAPI_PORT=9001
FASTAPI_HOST=0.0.0.0

# Spring Boot Service Configuration
SPRING_BOOT_BASE_URL=http://gestionproduit:9093/api

# GitHub AI Models API Configuration
GITHUB_API_KEY=your_github_pat_here
GITHUB_MODEL=gpt-4o-mini
GITHUB_URL=https://models.inference.ai.azure.com
GITHUB_TIMEOUT_SECONDS=30
GITHUB_MAX_RETRIES=3
GITHUB_RETRY_DELAY_MS=1000
GITHUB_ENABLED=true

# Chatbot Configuration
AI_EXTRACTION_ENABLED=true
FALLBACK_ON_AI_ERROR=true

# CORS Configuration (liste d'origines separees par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:4200
