# FastAPI Configuration
FASTAPI_ENV=development
FASTAPI_PORT=9001
FASTAPI_HOST=0.0.0.0

# Spring Boot Service Configuration
# For Docker: http://gestionproduit:9093/api
# For local development: http://localhost:9093/api
SPRING_BOOT_BASE_URL=http://gestionproduit:9093/api

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_DELAY_MS=1000
GEMINI_ENABLED=true

# Chatbot Configuration
AI_EXTRACTION_ENABLED=true
FALLBACK_ON_AI_ERROR=true
