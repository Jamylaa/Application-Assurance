# EditorConfig — style de code cohérent entre éditeurs/IDE. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java : convention 4 espaces
[*.java]
indent_size = 4

# Python : PEP 8, 4 espaces
[*.py]
indent_size = 4

# Makefile : tabulations obligatoires
[Makefile]
indent_style = tab

# Markdown : ne pas rogner les espaces de fin (sauts de ligne significatifs)
[*.md]
trim_trailing_whitespace = false
